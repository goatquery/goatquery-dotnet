<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>GoatQuery</RootNamespace>
    <LangVersion>12.0</LangVersion>

    <PackageId>GoatQuery</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/goatquery/goatquery-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/goatquery/goatquery-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>.NET Library to support filtering, ordering, pagination, and searching in REST APIs.</Description>
    <Authors>goatquery</Authors>
    <PackageTags>filter;paging;sorting;linq;querystring;rest;api</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentResults" Version="3.16.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
  </ItemGroup>
</Project>
